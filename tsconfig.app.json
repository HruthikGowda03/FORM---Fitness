{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    /*
      "node" is here for the test folder only: the design-token guard reads
      `index.css` and the component sources straight off disk, because Vitest
      runs with `css: false` and so stubs a `?raw` CSS import to an empty
      string. App code has no reason to touch a Node API, and if it starts to,
      Vite fails the build loudly rather than quietly shipping it.
    */
    "types": ["vite/client", "vitest/globals", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,

    /* Paths — relative to this file; no baseUrl needed (TS 5+) */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
