# FORM — Apache / cPanel / any shared host serving `dist/` as static files.
#
# Netlify, Cloudflare Pages and Vercel do not read this file; they use the
# equivalents in the repo root (`_redirects`, `vercel.json`). This is here so
# `dist/` works when uploaded to ordinary shared hosting, which is the one case
# that silently serves a 404 for every deep link otherwise.
#
# Upload the *contents* of dist/ into the public_html (or sub-directory) and
# keep this file at the top of it.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never rewrite a request for a file that actually exists, so hashed assets
  # and favicon.svg are served directly rather than falling through to the app.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route: hand back index.html and let React
  # Router resolve it.
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed filenames are immutable, so they can be cached hard.
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html must never be cached, or a deploy leaves people on old asset
  # hashes that no longer exist.
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# No ErrorDocument override on purpose. A genuinely missing file should 404 as a
# 404; serving index.html with a 200 for a missing .js produces a confusing
# MIME-type error in the console instead. The rewrite above already sends every
# real client route to the app.
